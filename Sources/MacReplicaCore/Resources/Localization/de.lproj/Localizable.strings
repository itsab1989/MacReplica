"credential.setup.saveKey.file" = "MacReplica-Wiederherstellungsschlüssel\n\n%1$@\n\nÖffnet die verschlüsselten Passwörter, Schlüssel und Zugangsdaten einer MacReplica-Sicherung, wenn die Passphrase vergessen wurde. Getrennt von der Sicherung aufbewahren.";
