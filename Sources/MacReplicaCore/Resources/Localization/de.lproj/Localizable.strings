"tools.profile.gatekeeper.name" = "MacReplica: Gatekeeper aus";
"tools.profile.gatekeeper.description" = "Von MacReplica auf deinen Wunsch erstellt. Solange dieses Profil installiert ist, prüft Gatekeeper keine App. Entferne es hier, um die Prüfung wieder einzuschalten.";
"tools.profile.deferral.name" = "MacReplica: macOS-Upgrades aufschieben";
"tools.profile.deferral.description" = "Von MacReplica auf deinen Wunsch erstellt. Eine neue macOS-Hauptversion wird erst %1$d Tage nach ihrer Veröffentlichung angeboten. Updates der installierten Version werden nicht verzögert. Entferne es hier, um das rückgängig zu machen.";
