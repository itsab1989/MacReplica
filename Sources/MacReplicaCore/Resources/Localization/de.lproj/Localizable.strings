"version.installs" = "Installiert Version %1$@";
"version.same" = "Installiert Version %1$@ – dieselbe Version wie auf dem alten Mac";
"version.newer" = "Installiert Version %1$@ – neuer als deine %2$@. Prüf, ob deine Dateien, Plug-ins und Lizenz damit funktionieren.";
