"guidance.credential.keychainPasswords" = "Wird nicht als Datei kopiert. Am besten: iCloud-Schlüsselbund auf beiden Macs einschalten (Systemeinstellungen › dein Name › iCloud › Passwörter). Oder den Migrationsassistenten nutzen, oder in der App „Passwörter“ „Ablage › Alle Passwörter in Datei exportieren“ wählen und die Datei auf dem neuen Mac importieren – diese Datei ist unverschlüsselt, lösche sie direkt nach dem Import. Zertifikate mit privatem Schlüssel: in der Schlüsselbundverwaltung als passwortgeschützte Datei exportieren.";
"guidance.credential.passkeys" = "Passkeys lassen sich nicht als Dateien kopieren. Passkeys im iCloud-Schlüsselbund kommen zurück, wenn du dich mit demselben Apple Account anmeldest und den iCloud-Schlüsselbund einschaltest. Passkeys eines Passwortmanagers kommen über dessen Synchronisierung zurück. Passkeys auf einem Hardware-Sicherheitsschlüssel bleiben auf diesem Schlüssel – bewahre ihn auf. Ein Passkey, der nur auf diesem Mac liegt (z. B. in einem Browserprofil), geht verloren: Richte für diese Konten vorher eine andere Anmeldemethode ein.";
"guidance.manual.passkeys" = "Passkeys lassen sich nicht als Dateien kopieren. Passkeys im iCloud-Schlüsselbund kommen zurück, wenn du dich mit demselben Apple Account anmeldest und den iCloud-Schlüsselbund einschaltest. Passkeys eines Passwortmanagers kommen über dessen Synchronisierung zurück. Passkeys auf einem Hardware-Sicherheitsschlüssel bleiben auf diesem Schlüssel – bewahre ihn auf. Ein Passkey, der nur auf diesem Mac liegt (z. B. in einem Browserprofil), geht verloren: Richte für diese Konten vorher eine andere Anmeldemethode ein.";
"guidance.credential.chromePasswords" = "Chrome verschlüsselt gespeicherte Passwörter mit einem Schlüssel im Schlüsselbund dieses Macs; eine Kopie des Profils bringt sie daher nicht zurück. Schalte die Synchronisierung mit deinem Google-Konto ein oder exportiere sie (Google Passwortmanager › Einstellungen › Passwörter exportieren) und importiere die Datei auf dem neuen Mac – lösche sie danach, sie ist unverschlüsselt. Passkeys, die nur im Chrome-Profil gespeichert sind, lassen sich nicht übertragen.";
"guidance.manual.chromePasswords" = "Chrome verschlüsselt gespeicherte Passwörter mit einem Schlüssel im Schlüsselbund dieses Macs; eine Kopie des Profils bringt sie daher nicht zurück. Schalte die Synchronisierung mit deinem Google-Konto ein oder exportiere sie (Google Passwortmanager › Einstellungen › Passwörter exportieren) und importiere die Datei auf dem neuen Mac – lösche sie danach, sie ist unverschlüsselt. Passkeys, die nur im Chrome-Profil gespeichert sind, lassen sich nicht übertragen.";
"guidance.credential.edgePasswords" = "Edge schützt gespeicherte Passwörter mit einem Schlüssel dieses Macs. Nutze die Synchronisierung mit deinem Microsoft-Konto oder exportiere sie (Einstellungen › Kennwörter › Mehr › Kennwörter exportieren) und importiere die Datei auf dem neuen Mac – laut Microsoft ist die Datei ungeschützt, lösche sie danach.";
"guidance.manual.edgePasswords" = "Edge schützt gespeicherte Passwörter mit einem Schlüssel dieses Macs. Nutze die Synchronisierung mit deinem Microsoft-Konto oder exportiere sie (Einstellungen › Kennwörter › Mehr › Kennwörter exportieren) und importiere die Datei auf dem neuen Mac – laut Microsoft ist die Datei ungeschützt, lösche sie danach.";
"guidance.credential.bravePasswords" = "Brave (auf Chromium-Basis) schützt gespeicherte Passwörter mit einem Schlüssel dieses Macs. Nutze Brave Sync oder exportiere sie in den Passworteinstellungen von Brave und importiere die Datei auf dem neuen Mac – lösche sie danach, sie ist unverschlüsselt.";
"guidance.manual.bravePasswords" = "Brave (auf Chromium-Basis) schützt gespeicherte Passwörter mit einem Schlüssel dieses Macs. Nutze Brave Sync oder exportiere sie in den Passworteinstellungen von Brave und importiere die Datei auf dem neuen Mac – lösche sie danach, sie ist unverschlüsselt.";
"guidance.credential.firefoxPasswords" = "Firefox speichert Zugangsdaten im Profil (logins.json zusammen mit key4.db). Nutze Firefox Sync, exportiere sie (Passwörter › ⋯ › Passwörter exportieren; unverschlüsselt, danach löschen) oder kopiere – bei auf beiden Macs geschlossenem Firefox – beide Dateien zusammen ins neue Profil, wie Mozilla es beschreibt. Mit Hauptpasswort brauchst du dieses auf dem neuen Mac.";
"guidance.manual.firefoxPasswords" = "Firefox speichert Zugangsdaten im Profil (logins.json zusammen mit key4.db). Nutze Firefox Sync, exportiere sie (Passwörter › ⋯ › Passwörter exportieren; unverschlüsselt, danach löschen) oder kopiere – bei auf beiden Macs geschlossenem Firefox – beide Dateien zusammen ins neue Profil, wie Mozilla es beschreibt. Mit Hauptpasswort brauchst du dieses auf dem neuen Mac.";
"guidance.credential.onePassword" = "Deine Tresore kommen zurück, wenn du dich auf dem neuen Mac anmeldest – dafür brauchst du dein Kontopasswort und deinen Geheimschlüssel (im Emergency Kit). Stelle sicher, dass du das Emergency Kit hast, bevor du diesen Mac löschst. Ein 1PUX-Export ist unverschlüsselt; vermeide ihn, wenn du ihn nicht brauchst.";
"guidance.credential.bitwarden" = "Dein Tresor kommt zurück, wenn du dich auf dem neuen Mac anmeldest. Möchtest du zusätzlich eine Datei, nutze den passwortgeschützten verschlüsselten Export von Bitwarden – ein einfacher .json- oder .csv-Export ist unverschlüsselt.";
"sensitive.kind.passwordManagerExport" = "unverschlüsselter Export eines Passwortmanagers (alle Passwörter im Klartext)";
"sensitive.kind.recoveryMaterial" = "Wiederherstellungscodes, -schlüssel oder Notfallkit";
"sensitive.advice.passwordManagerExport" = "Sie enthält alle Passwörter unverschlüsselt. Brauchst du sie noch, füge sie dem verschlüsselten Teil der Sicherung hinzu; besser: jetzt in den Passwortmanager importieren und löschen.";
"sensitive.advice.recoveryMaterial" = "Der Weg zurück in ein Konto, wenn du den zweiten Faktor verlierst. Füge sie dem verschlüsselten Teil der Sicherung hinzu und bewahre zusätzlich eine Kopie offline auf (ausgedruckt oder auf einem anderen Gerät).";
"credential.section.title" = "Passwörter, Schlüssel und Zugangsdaten";
"credential.section.message" = "Füge beliebig viele Schlüsseldateien, Passwortdatenbanken und andere Zugangsdateien hinzu – aus jedem Ordner oder Laufwerk. Sie werden nur verschlüsselt gespeichert und nach dem Verschlüsseln einzeln geprüft. Nichts hiervon ist in der Sicherung, solange du es nicht hinzufügst.";
"credential.section.help" = "Verschlüsselung: AES-256-GCM. Ein Zufallsschlüssel verschlüsselt die Dateien; er ist durch deine Passphrase (PBKDF2-HMAC-SHA256, 600.000 Runden) und durch einen von MacReplica erzeugten Wiederherstellungsschlüssel geschützt. Keines von beiden wird gespeichert. Jede Datei wird einzeln verschlüsselt, wieder entschlüsselt und verglichen, bevor die Sicherung sie als gesichert zählt. Auf dem neuen Mac kommt jede Datei mit privaten Zugriffsrechten an ihren Ort zurück; eine vorhandene andere Datei wird nie ohne deine Entscheidung ersetzt. Schlüsselbunde, Passkeys und Passwortspeicher von Browsern lassen sich nicht als Dateien übertragen – dieser Bereich zeigt dir, wie es geht.";
"credential.add.button" = "Schlüssel oder Passwortdateien hinzufügen …";
"credential.add.prompt" = "Verschlüsselt hinzufügen";
"credential.add.message" = "Wähle Schlüsseldateien, Passwortdatenbanken oder Ordner, die sie enthalten. Du kannst mehrere gleichzeitig auswählen.";
