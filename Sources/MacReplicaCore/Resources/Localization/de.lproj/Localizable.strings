"sensitive.advice.passwordDatabase" = "Füge sie dem verschlüsselten Teil der Sicherung hinzu: Sie kommt geprüft und byte-genau an denselben Ort zurück. Du brauchst weiterhin das Master-Passwort – und die Schlüsseldatei, falls verwendet.";
"sensitive.advice.keePassKeyFile" = "Zusammen mit dem Master-Passwort öffnet sie eine KeePass-Datenbank. Füge sie dem verschlüsselten Teil der Sicherung hinzu und bewahre eine weitere Kopie getrennt von der Datenbank auf (z. B. auf einem anderen Laufwerk), damit sie ein zweiter Faktor bleibt.";
"sensitive.advice.privateKey" = "Füge ihn dem verschlüsselten Teil der Sicherung hinzu: Er kommt an denselben Ort zurück, nur für deinen Benutzer lesbar. Hat der Schlüssel eine Passphrase, brauchst du auch diese. Schlüssel, die nur im Schlüsselbund liegen: in der Schlüsselbundverwaltung als passwortgeschützte Datei exportieren.";
"sensitive.advice.certificate" = "Zertifikate sind meist öffentlich. Füge es bei Bedarf dem verschlüsselten Teil der Sicherung hinzu; der private Schlüssel ist nicht enthalten – sichere ihn ebenfalls.";
"sensitive.advice.pgpKey" = "Füge ihn dem verschlüsselten Teil der Sicherung hinzu. Schlüssel, die nur in einem GPG-Schlüsselbund liegen: mit deinem PGP-Werkzeug (mit Passphrase) exportieren und die exportierte Datei hinzufügen.";
"sensitive.advice.keychain" = "Wird nicht als Datei kopiert. Nutze den iCloud-Schlüsselbund, den Migrationsassistenten oder den Export der App „Passwörter“ (Ablage › Alle Passwörter in Datei exportieren – die Datei ist unverschlüsselt, nach dem Import löschen). Eine kopierte Schlüsselbunddatei öffnet sich nur mit dem Passwort, das sie auf diesem Mac hatte.";
"sensitive.advice.browserData" = "Wird nie kopiert (aktive Anmeldungen). Melde dich erneut an; für gespeicherte Passwörter und Lesezeichen nutze die Synchronisierung des Browsers.";
"sensitive.advice.secretsFile" = "Sie enthält meist API-Token oder Passwörter. Füge sie bei Bedarf dem verschlüsselten Teil der Sicherung hinzu.";
"sensitive.advice.nameSuggestsSecret" = "Nur der Name deutet auf ein Geheimnis hin. Brauchst du die Datei, füge sie dem verschlüsselten Teil der Sicherung hinzu.";
"sensitive.rememberedByApp" = "KeePassXC kennt diese Datenbank, aber sie liegt außerhalb der für das Backup gewählten Ordner.";
"sensitive.exclude.button" = "Auslassen";
"sensitive.includedAs" = "Auf deinen Wunsch aufgenommen (%1$@), unverändert kopiert";
"backupIssue.detail.rememberedByApp" = "nicht in den gewählten Ordnern (von KeePassXC gemerkt)";
"appData.category.passwordManagerSettings" = "Einstellungen";
"appData.help.passwordManagerSettings" = "Die Einstellungen von KeePassXC (keepassxc.ini): Darstellung, Sicherheit und Browser-Integration. Deine Datenbanken und Schlüsseldateien gehören nicht dazu – nimm sie ausdrücklich unter „Nicht in diesem Backup“ auf.";
"appData.category.scannerSettings" = "Scan-Einstellungen und gespeicherte Optionen";
"appData.help.scannerSettings" = "Die Einstellungen von VueScan (vuescan.ini, beim Beenden gespeichert) und Optionssätze, die du mit Ablage › Optionen sichern in ~/Pictures/VueScan gespeichert hast, dazu dort abgelegte Farbprofile. Das Protokoll bleibt zurück. Die Lizenz wird nicht kopiert – gib deine Seriennummer erneut ein.";
"bootstrap.summary" = "MacReplica %1$@ ist in diesem Backup (läuft auf %2$@).";
"bootstrap.notUniversal" = "Diese Kopie läuft nur auf Macs mit %1$@; auf einem anderen Mac lade MacReplica stattdessen herunter.";
"bootstrap.readme" = "Hier beginnst du auf dem neuen Mac: Zieh %1$@ aus diesem Ordner in den Ordner „Programme“, öffne es, wähle „Wiederherstellen“ und dann diesen Ordner. MacReplica ist nicht von Apple beglaubigt: Meldet macOS, dass der Entwickler nicht überprüft werden kann, wähle „Fertig“, öffne Systemeinstellungen › Datenschutz & Sicherheit und klicke auf „Trotzdem öffnen“. Die neueste Version gibt es unter %2$@.";
"bootstrap.saved.message" = "Nach der Neuinstallation von macOS öffnest du dieses Backup und startest MacReplica direkt daraus – ohne Download. Die README im Backup erklärt die ersten Schritte.";
"bootstrap.missing" = "MacReplica selbst ist nicht in diesem Backup";
"bootstrap.missing.message" = "Leg eine Kopie von MacReplica auf das Backup-Laufwerk oder lade es auf dem neuen Mac von %1$@.";
"guide.newMac.1.fromBackup" = "Zieh MacReplica.app aus dem Backup-Ordner in „Programme“ und öffne es (falls macOS den Entwickler nicht überprüfen kann: Systemeinstellungen › Datenschutz & Sicherheit › Trotzdem öffnen).";
"completeness.restore.message" = "Diese Dateien sind nicht im Backup. Wenn du den alten Mac noch hast, kopiere von dort, was du brauchst.";
"taps.help" = "Ein Tap ist eine Paketquelle außerhalb von Homebrews eigener Sammlung, meist vom Entwickler einer App betrieben (z. B. itsab1989/chromiq für ChromIQ). Pakete aus einem Tap werden nur installiert, wenn du ihn hier erlaubst. Bei jedem Tap steht, welche Apps und Pakete ihn brauchen; ohne ihn werden sie übersprungen und im Ergebnis aufgeführt.";
"taps.neededFor" = "Gebraucht für: %1$@";
"taps.suggested" = "Von MacReplica vorgeschlagen: Der Entwickler von %1$@ nennt diesen Tap; auf dem alten Mac war er nicht eingerichtet.";
"cask.removed" = "Homebrew kann es nicht mehr installieren: Das Cask „%1$@“ wurde aus Homebrew entfernt. Die installierte Kopie funktioniert weiter; auf dem neuen Mac verwendet MacReplica stattdessen den Download des Entwicklers oder dein Installationsprogramm.";
"cask.disabled" = "Homebrew kann es nicht mehr installieren: Das Cask „%1$@“ wurde am %2$@ deaktiviert (%3$@). Auf dem neuen Mac verwendet MacReplica stattdessen den Download des Entwicklers oder dein Installationsprogramm.";
