"tools.updates.securityOff.message" = "Fixes for actively exploited problems reach this Mac late or not at all. Turning them on does not install a new macOS version.";
"tools.updates.managed.title" = "Your organisation manages updates";
"tools.updates.managed.message" = "A profile sets Software Update on this Mac. MacReplica only shows the settings.";
"tools.updates.stay.title" = "Stay on this macOS version";
"tools.updates.stay.help" = "Recommended: download, install macOS updates and install security updates on. Your Mac then stays current within this version. It installs a new major version only when you click “Upgrade” in Software Update or in a notification. Use “More info…” and install single updates if you want to avoid the upgrade, and do not click “Update all” if it lists the new version.";
"tools.updates.stay.message" = "Automatic installation keeps this version up to date; a new major version is installed only after you click “Upgrade”.";
