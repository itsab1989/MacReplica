"tools.plugin.checking" = "Checking this Mac…";
"tools.plugin.next" = "Next step:";
"tools.plugin.next.unsupportedHardware" = "None – Plugin Playground only works on Mac computers with Apple silicon, so the corner plugin is not available on this Mac.";
"tools.plugin.next.untestedBuild" = "None for now – the plugin was not tested on this macOS build and would do nothing here, so MacReplica offers it only after a MacReplica update has been tested on this version.";
"tools.plugin.next.sipFullyOn" = "Allow debugging in recoveryOS (step 1 below). This is the only step MacReplica cannot do for you. Afterwards come back here and click “Set up automatically…”.";
"tools.plugin.next.loaderMissing" = "Click “Set up automatically…”. MacReplica shows what it will do and asks for your administrator password once.";
"tools.plugin.next.removedPendingRestart" = "Restart the Mac. Plugin Playground was removed, but its background service keeps running until the restart.";
"tools.plugin.next.serviceMissing" = "Click “Finish setup automatically…”. MacReplica sets up and starts Plugin Playground's background service – the same as “Install” in the Daemon section of Plugin Playground's own window. You do not need to open Plugin Playground.";
"tools.plugin.next.injectorNotRunning" = "Plugin Playground's background service is set up, but its injector is not running. Restart the Mac and open this section again. If it still does not run, debugging is probably not allowed – repeat step 1.";
"tools.plugin.next.pacOff" = "Click “Finish setup automatically…”. MacReplica turns on Plugin Playground's “Disable arm64e (PAC)” setting, which Apple's own apps need.";
"tools.plugin.next.pluginMissing" = "Click “Finish setup automatically…” to install or update MacReplica's corner plugin.";
"tools.plugin.next.reopen" = "Setup is complete and verified. Quit and reopen the apps you want to change – apps that were already open do not get the plugin – or restart the Mac. Reopen MacReplica too: the last line then confirms that the plugin is loaded.";
"tools.plugin.next.ready" = "Nothing – the plugin is set up and loaded. Apps use the surfaces ticked above when they open; after changing the selection, reopen the apps.";
"tools.plugin.next.unknown" = "MacReplica could not read part of the state (rows with a question mark). Click “Check again”; if it stays that way, restart the Mac and check again.";
"tools.plugin.step.installLoader" = "Download Plugin Playground 1.1.0 from its official GitHub release, verify its checksum and install it";
"tools.plugin.step.installPlugin" = "Copy MacReplica's corner plugin into Plugin Playground's tweaks folder";
"tools.plugin.step.savePACSetting" = "Turn on “Disable arm64e (PAC)” — needed for Apple's own apps, but it makes the loader run every arm64e app from an unsigned copy in /tmp";
"tools.plugin.step.installService" = "Set up Plugin Playground's background service (a launch daemon that starts with the Mac)";
"tools.plugin.step.startService" = "Start the background service now, so no restart is needed";
"tools.plugin.req.pac" = "“Disable arm64e (PAC)” is on (needed for Apple's own apps)";
"tools.plugin.req.active" = "The plugin is loaded in MacReplica (proof that it works)";
"tools.plugin.oneClick.finish" = "Finish setup automatically…";
"tools.plugin.oneClick.confirm.intro" = "MacReplica will do these steps, with one administrator password prompt:";
"tools.plugin.setup.verified" = "Setup complete and verified:";
"tools.plugin.setup.incomplete" = "Setup is not complete:";
"tools.plugin.setup.partial" = "Steps marked ✓ are done and stay in place. Running the setup again is safe – it only repeats what is still missing.";
"tools.plugin.setup.nothingChanged" = "Nothing was changed on your Mac. You can safely try again.";
"tools.plugin.setup.lastExit" = "The background service last ended with code %1$@.";
"tools.plugin.undo.done" = "MacReplica's plugin and Plugin Playground (app, files, settings and background-service file) are removed.";
"tools.plugin.undo.stillRunning" = "The background service keeps running until you restart. MacReplica does not stop it, because stopping it from outside can make the Mac crash. Restart now, and in recoveryOS turn System Integrity Protection fully back on (csrutil enable).";
"tools.change.windowCorners.oneClickSetUp" = "Corner plugin set up";
"tools.change.windowCorners.oneClickUndo" = "Corner plugin and Plugin Playground removed";
"tools.plugin.req.unsupportedHardware" = "Only Mac computers with Apple silicon";
"tools.plugin.req.untested" = "macOS build %1$@ was not tested – the plugin may do nothing here, or in the worst case make apps crash";
"tools.plugin.untested.ack" = "I understand this macOS build was not tested and set it up anyway, at my own risk";
"tools.plugin.oneClick.confirm.untested" = "⚠︎ macOS build %1$@ was not tested with this plugin. It will still load, but a hook may do nothing, or in the worst case make apps crash. Only continue if you accept that.";
"tools.plugin.pacNote" = "Heads-up: “Disable arm64e (PAC)” runs your Apple-silicon apps from unsigned copies in /tmp. Most work; some can crash or misbehave (and can be blacklisted). This is a big, system-wide change, fully undone by “Undo setup…”.";
"note.homebrewUpdated" = "Homebrew on this Mac was too old for the current package definitions, so MacReplica updated it once (brew update, now %1$@) and tried again.";
"failure.homebrewOutdated.title" = "Homebrew is too old";
"failure.homebrewOutdated.explanation" = "Homebrew on this Mac (for example one brought back from a Time Machine backup) cannot read the current package definitions. MacReplica ran “brew update” once, which did not help. Open Terminal, run “brew update”, then choose Retry Failed Items.";
"failure.backupUnreachable.title" = "Backup copy could not be read";
"failure.backupUnreachable.explanation" = "MacReplica could not find or read the copy in the backup – this does not mean it is damaged. Is the drive or network share with the backup still connected? Connect it again, then choose Retry Failed Items. “Check Backup” shows whether the files are intact.";
"retry.backupMissing.message" = "The backup at %1$@ is not available. Connect the drive or network share with the backup, then choose Retry Failed Items again.";
"manual.hint.ownInstaller" = "Your own installer is used: choose Continue with Guided Steps. If it is not in the backup, connect the drive it is on.";
"verify.result.intactWithGaps" = "The saved files are undamaged – but the backup is not complete.";
"verify.result.gapsMessage" = "Files that could not be saved when the backup was made are not in it, so no check can find them; they are listed below.";
"reinstall.preflight.t2External" = "This Mac has the T2 chip. If you might install from a USB installer, allow that now, before you erase: Startup Security Utility asks for an administrator account of this Mac, and after the disk is erased there is none until macOS is installed again. Start up from macOS Recovery (Command-R), choose Utilities › Startup Security Utility, click Enter macOS Password, choose an administrator and enter its password, then under Allowed Boot Media choose “Allow booting from external or removable media”.";
"reinstall.usb.title" = "Install from a USB installer (optional)";
"reinstall.usb.intro" = "Prepare the USB installer before you erase this Mac – on this Mac or on another one. It avoids the download in macOS Recovery. These are Apple's steps (“Create a bootable installer for macOS”).";
"reinstall.usb.create.title" = "Create the USB installer";
"reinstall.usb.create.1" = "Use a USB flash drive of 32 GB or more (Apple: enough for any macOS installer). Everything on it is erased.";
"reinstall.usb.create.2" = "Download the full macOS installer: Apple's page “How to download and install macOS” links to it in the App Store. When the download ends the installer opens by itself – quit it; it stays in the Applications folder.";
"reinstall.usb.create.3" = "Connect the USB drive and rename it “MyVolume” in the Finder (the command below expects this name).";
"reinstall.usb.create.4" = "Open Terminal (Applications › Utilities) and enter this command for “%1$@” (for another macOS version, use the name of its installer):";
"reinstall.usb.create.5" = "Press Return, enter the administrator password (nothing appears while you type), type Y to confirm that the drive is erased, and wait until Terminal says the install media is now available.";
"reinstall.usb.start.title" = "Start up from the USB installer";
"reinstall.usb.start.as.1" = "Shut down the Mac and connect the USB installer.";
"reinstall.usb.start.as.2" = "Press and hold the power button until the startup options appear.";
"reinstall.usb.start.as.3" = "Select the USB installer and click Continue.";
"reinstall.usb.start.as.4" = "Follow the instructions on screen. For a clean installation, erase the disk with Disk Utility first (see below).";
"reinstall.usb.start.intel.1" = "Shut down the Mac and connect the USB installer.";
"reinstall.usb.start.intel.2" = "Turn on the Mac and immediately press and hold the Option (Alt) key.";
"reinstall.usb.start.intel.3" = "Release the key when the bootable volumes appear, select the USB installer and press Return.";
"reinstall.usb.start.intel.4" = "Choose your language if asked, then choose Install macOS in the Utilities window. For a clean installation, open Disk Utility there first and erase the disk (see below).";
"reinstall.usb.start.t2" = "If the Mac does not start from the USB installer, Startup Security Utility does not allow external media. Changing that needs an administrator account of this Mac – that is why it must be done before you erase (see “Before you start”).";
