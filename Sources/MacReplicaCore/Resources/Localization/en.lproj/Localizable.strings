"tools.gatekeeper.profileOff.confirm.message" = "Remove the profile “MacReplica: Gatekeeper off” in Device Management. MacReplica then checks that macOS checks apps again.";
"tools.gatekeeper.profileOff.verified" = "MacReplica's profile is gone and macOS checks apps again.";
"tools.gatekeeper.profileOff.stillOff" = "MacReplica's profile is gone, but apps are still not checked: another profile or the “Anywhere” choice keeps Gatekeeper off. See the state above.";
"tools.updates.deferral.title" = "Postpone major macOS upgrades";
"tools.updates.deferral.help" = "With a configuration profile (com.apple.applicationaccess, “forceDelayedMajorSoftwareUpdates”), macOS offers a new major version only 30, 60 or 90 days after its release. Apple allows at most 90 days; each new release starts its own period, so this postpones but never blocks an upgrade. MacReplica offers it only where updates of your current version keep coming: macOS 13 to 15.7.4 and macOS 26 (deprecated by Apple there). From macOS 15.7.5 the same setting also delays security updates, and macOS 27 removed it. You install and remove the profile in Device Management; MacReplica checks what macOS reports.";
"tools.updates.deferral.available" = "Available on this macOS version, for at most 90 days after each release.";
"tools.updates.deferral.availableDeprecated" = "Available on macOS 26 for at most 90 days after each release. Apple has deprecated it and removed it in macOS 27, so an update may end it.";
"tools.updates.deferral.wouldDelaySecurityUpdates" = "Not offered on this version: since macOS 15.7.5 the same setting also delays security updates of the installed version.";
"tools.updates.deferral.removed" = "Not possible on this version: macOS 27 removed the setting; only an organisation's device management can postpone upgrades. Nothing blocks an upgrade permanently – it still needs your click on “Upgrade”.";
"tools.updates.deferral.olderThanSupported" = "Not offered on this macOS version.";
