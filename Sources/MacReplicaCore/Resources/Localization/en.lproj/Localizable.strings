"tools.updates.support.current.message" = "It receives all updates and security fixes.";
"tools.updates.support.securityUpdates.title" = "macOS %1$@ still receives security updates";
"tools.updates.support.securityUpdates.message" = "Apple still offers this version. Older versions usually get only some of the fixes, and Background Security Improvements only come to the newest version.";
"tools.updates.support.likelyEnded.title" = "macOS %1$@ probably no longer receives security updates";
"tools.updates.support.likelyEnded.message" = "Three newer macOS versions exist, and Apple usually stops fixing older ones. Staying on this version leaves known security problems open. Consider upgrading to a version this Mac supports.";
"tools.updates.support.unknown.title" = "No answer for macOS %1$@";
"tools.updates.support.unknown.message" = "Apple's servers did not answer (no internet connection?). MacReplica does not guess.";
