"tools.plugin.oneClick.confirm.message" = "Il debug è già consentito. MacReplica scarica Plugin Playground dalla sua versione ufficiale (una versione fissa, verificata con un checksum noto prima dell’installazione), lo installa con la password di amministratore e installa il proprio plug-in. Poi apre Plugin Playground perché tu lo attivi (attiva l’iniezione e «Disable arm64e (PAC)») e riavvii. Questo indebolisce la sicurezza del Mac finché il caricatore è attivo. Se il download o il checksum non corrispondono, non viene installato nulla.";
"tools.plugin.oneClick.reason" = "MacReplica vuole installare il caricatore Plugin Playground e il suo plug-in degli angoli.";
"tools.plugin.oneClick.needsSIP" = "Consenti prima il debug: in recoveryOS esegui «csrutil enable --without debug» e riavvia (i passaggi sono sopra). MacReplica non può e non cambierà la protezione dell’integrità del sistema al posto tuo.";
"tools.plugin.oneClick.download" = "Non è stato possibile scaricare Plugin Playground. Installalo tu da github.com/CoreBedtime/playground con i passaggi sopra, o riprova più tardi.";
"tools.plugin.oneClick.checksum" = "Il Plugin Playground scaricato non corrispondeva al checksum atteso, quindi MacReplica non l’ha installato. Installalo tu con i passaggi sopra.";
"tools.plugin.undo.button" = "Annulla la configurazione…";
"tools.plugin.undo.go" = "Rimuovi e annulla";
"tools.plugin.undo.message" = "MacReplica rimuove il suo plug-in e disinstalla il caricatore Plugin Playground (app, file e helper) con la password di amministratore. Plugin Playground non modifica alcuna impostazione di avvio da ripristinare. Dopo, riavvia e riattiva la protezione dell’integrità del sistema in recoveryOS (csrutil enable); MacReplica non lo cambia mai da solo.";
"tools.plugin.undo.reason" = "MacReplica vuole rimuovere il suo plug-in e disinstallare il caricatore Plugin Playground.";
"tools.plugin.undo.rebootSIP" = "Ora riavvia e riattiva completamente la protezione dell’integrità del sistema in recoveryOS (csrutil enable).";
