"ownInstaller.approve" = "Bruk dette ubekreftede installasjonsprogrammet";
"ownInstaller.approve.help" = "Noen seriøse gratisapper (for eksempel DisplayCAL) er ikke signert med en Developer ID, så verken macOS eller MacReplica kan bekrefte hvem som har laget dem. Kryss av bare hvis du stoler på hvor du fikk filen, helst utviklerens eget nettsted. MacReplica lagrer sjekksummen, så på den nye Macen brukes bare nøyaktig denne filen – men det gjør den ikke trygg. Ingenting i macOS slås av: første gang appen starter, ber macOS deg tillate den under Systeminnstillinger › Personvern og sikkerhet › Åpne likevel. La det stå av hvis du heller vil installere appen selv.";
"ownInstaller.add.help" = "Velg installasjonsprogrammet du har for denne appen: et diskavbilde (.dmg), en installasjonspakke (.pkg), et zip-arkiv (.zip) eller selve appen (.app). Du kan legge til flere pakker, for eksempel en aktiveringspakke, i den rekkefølgen de installeres. Hver fil kontrolleres med en gang; ingenting i den kjøres. Du ser hva den inneholder, om MacReplica vil bruke den og hva som skjer med den på den nye Macen.";
"ownInstaller.section.help" = "Nedlastinger forsvinner, og den nye Macen har kanskje ikke internett i starten. Har du installasjonsprogrammer – for eksempel på en ekstern disk – registrerer MacReplica dem med sjekksum og kan kopiere dem til sikkerhetskopien. På den nye Macen brukes de uten internett og gir deg nøyaktig den versjonen du hadde. Installasjonsprogrammer kjøres aldri under sikkerhetskopieringen; diskavbilder åpnes bare skrivebeskyttet for å se hvilken app de inneholder.";
"ownInstaller.inspecting" = "Kontrollerer installasjonsprogrammet …";
"ownInstaller.problem.title" = "%1$@ kan ikke brukes";
"ownInstaller.problem.dismiss" = "OK";
"ownInstaller.problem.unsupported" = "Dette er ikke et installasjonsprogram MacReplica kan bruke. Støttet er diskavbilder (.dmg), installasjonspakker (.pkg, .mpkg), zip-arkiver (.zip) og apper (.app).";
"ownInstaller.problem.unreadable" = "Filen kan ikke leses. Kontroller at disken er tilkoblet og at du har tilgang til filen.";
"ownInstaller.problem.damaged" = "Diskbildet er skadet: macOS kontrollerte sjekksummen som er lagret i det, og den stemmer ikke – innholdet er endret etter at det ble laget. MacReplica tar det ikke med. Last det ned på nytt fra utvikleren.";
"ownInstaller.problem.nothingInside" = "Det finnes ingen app, installasjonspakke eller diskavbilde inni, så MacReplica kan ikke installere noe fra den.";
