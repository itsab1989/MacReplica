"frontEnd.homebrew.one" = "Et grafisk grensesnitt for Homebrew. Å gjenopprette det gjenoppretter verken Homebrew eller pakkene dine – de gjenopprettes med Homebrew (%1$d pakke i denne sikkerhetskopien).";
"frontEnd.homebrew.other" = "Et grafisk grensesnitt for Homebrew. Å gjenopprette det gjenoppretter verken Homebrew eller pakkene dine – de gjenopprettes med Homebrew (%1$d pakker i denne sikkerhetskopien).";
"frontEnd.homebrew.missing" = "Et grafisk grensesnitt for Homebrew – men Homebrew ble ikke funnet eller kunne ikke brukes på denne Macen, så ingen Homebrew-pakker er i sikkerhetskopien. Denne appen alene installerer ikke Homebrew.";
