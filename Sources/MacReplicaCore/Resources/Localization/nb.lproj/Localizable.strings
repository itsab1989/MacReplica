"guide.newMac.1.fromBackup" = "Dra MacReplica.app fra sikkerhetskopimappen til Programmer og åpne den (hvis macOS ikke kan bekrefte utvikleren: Systeminnstillinger › Personvern og sikkerhet › Åpne likevel).";
"completeness.restore.message" = "Disse filene er ikke i sikkerhetskopien. Har du fortsatt den gamle Macen, kopierer du det du trenger derfra selv.";
"taps.help" = "En tap er en pakkekilde utenfor Homebrews egen samling, som regel drevet av appens utvikler (for eksempel itsab1989/chromiq for ChromIQ). Pakker fra en tap installeres bare hvis du tillater den her. Hver tap viser hvilke apper og pakker som trenger den; uten den hoppes de over og vises i resultatet.";
