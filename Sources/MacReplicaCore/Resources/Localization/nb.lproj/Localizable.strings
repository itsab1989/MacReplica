"backupIssue.detail.unsupportedName" = "utelatt (et navn som starter med «~» kan ikke lagres trygt i en sikkerhetskopi – gi filen nytt navn for å ta den med)";
"appData.refused.where" = "Se «Ikke i denne sikkerhetskopien» over for hvilke filer og hvorfor.";
"notInBackup.title.one" = "Ikke i denne sikkerhetskopien: %1$d fil";
"notInBackup.title.other" = "Ikke i denne sikkerhetskopien: %1$d filer";
"notInBackup.help" = "Filer i de valgte mappene som ikke kommer med i sikkerhetskopien, hver med årsak og hva du kan gjøre. Sjekk denne listen før du sletter denne Macen. Filer som ser ut som passord eller nøkler utelates med vilje; de du trenger, kan du ta med.";
"notInBackup.gaps.one" = "%1$d fil kunne ikke tas med";
"notInBackup.gaps.other" = "%1$d filer kunne ikke tas med";
"notInBackup.gaps.help" = "Disse var valgt, men mangler i sikkerhetskopien: de kunne ikke leses, ble endret under kopieringen, ble slettet etter skanningen, finnes bare i iCloud eller har et navn en sikkerhetskopi ikke kan lagre. Rett opp årsaken og lagre sikkerhetskopien på nytt, eller kopier dem selv.";
"notInBackup.sensitive.one" = "%1$d fil er ikke i sikkerhetskopien ennå (ser ut som en hemmelighet)";
"notInBackup.sensitive.other" = "%1$d filer er ikke i sikkerhetskopien ennå (ser ut som hemmeligheter)";
"notInBackup.sensitive.help" = "Filer som ser ut som passord, nøkler eller innloggingsdata, kopieres aldri som de er. Du kan legge til hver du trenger i den krypterte delen av sikkerhetskopien (se «Passord, nøkler og påloggingsdata»). MacReplica gjenkjenner dem bare på navn og filformat; innholdet leses, lagres eller logges aldri. Nøkkelringer og nettleseres passordlagre kopieres ikke – de ville ikke virke på en annen Mac.";
"notInBackup.included.one" = "%1$d sensitiv fil tatt med etter ønske fra deg";
"notInBackup.included.other" = "%1$d sensitive filer tatt med etter ønske fra deg";
"notInBackup.included.help" = "Disse kopieres uendret til sikkerhetskopimappen, som ikke er kryptert: oppbevar sikkerhetskopien et trygt sted. En kryptert passorddatabase forblir kryptert. De gjenopprettes der de var, som de andre filene dine.";
"notInBackup.reveal" = "Vis i Finder";
