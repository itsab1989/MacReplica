"sensitive.advice.passwordDatabase" = "Legg den til i den krypterte delen av sikkerhetskopien: den kommer tilbake til samme sted, kontrollert byte for byte. Du trenger fortsatt hovedpassordet – og nøkkelfilen, hvis den brukes.";
"sensitive.advice.keePassKeyFile" = "Sammen med hovedpassordet åpner den en KeePass-database. Legg den til i den krypterte delen av sikkerhetskopien, og ha en annen kopi adskilt fra databasen (for eksempel på en annen disk) så den forblir en andre faktor.";
"sensitive.advice.privateKey" = "Legg den til i den krypterte delen av sikkerhetskopien: den kommer tilbake til samme sted, bare lesbar for brukeren din. Har nøkkelen en passordfrase, trenger du den også. Nøkler som bare ligger i nøkkelringen: eksporter dem i Nøkkelringtilgang som en passordbeskyttet fil.";
"sensitive.advice.certificate" = "Sertifikater er som regel offentlige. Legg det til i den krypterte delen av sikkerhetskopien om du trenger det; den private nøkkelen er ikke med – ta vare på den også.";
"sensitive.advice.pgpKey" = "Legg den til i den krypterte delen av sikkerhetskopien. Nøkler som bare ligger i en GPG-nøkkelring: eksporter dem med PGP-verktøyet (med passordfrase) og legg til den eksporterte filen.";
"sensitive.advice.keychain" = "Kopieres ikke som fil. Bruk iCloud-nøkkelring, Overføringsassistent eller eksport i Passord-appen (Arkiv › Eksporter alle passord – filen er ikke kryptert, slett den etter importen). En kopiert nøkkelringfil åpnes bare med passordet den hadde på denne Macen.";
"sensitive.advice.browserData" = "Kopieres aldri (aktive pålogginger). Logg inn på nytt; bruk nettleserens egen synkronisering for lagrede passord og bokmerker.";
"sensitive.advice.secretsFile" = "Den inneholder som regel API-tokener eller passord. Legg den til i den krypterte delen av sikkerhetskopien om du trenger den.";
"sensitive.advice.nameSuggestsSecret" = "Bare navnet tyder på en hemmelighet. Trenger du den, legg den til i den krypterte delen av sikkerhetskopien.";
"sensitive.rememberedByApp" = "KeePassXC husker denne databasen, men den ligger utenfor mappene som er valgt for sikkerhetskopien.";
"sensitive.exclude.button" = "Utelat";
"sensitive.includedAs" = "Tatt med etter ønske fra deg (%1$@), kopiert uendret";
"backupIssue.detail.rememberedByApp" = "ikke i de valgte mappene (husket av KeePassXC)";
"appData.category.passwordManagerSettings" = "Innstillinger";
"appData.help.passwordManagerSettings" = "KeePassXCs innstillinger (keepassxc.ini): utseende, sikkerhet og nettleserintegrasjon. Databasene og nøkkelfilene dine er ikke med her – ta dem med uttrykkelig under «Ikke i denne sikkerhetskopien».";
"appData.category.scannerSettings" = "Skanneinnstillinger og lagrede alternativer";
"appData.help.scannerSettings" = "VueScans innstillinger (vuescan.ini, lagret når VueScan avsluttes) og alternativsett du har lagret med Arkiv › Lagre alternativer i ~/Pictures/VueScan, pluss fargeprofiler der. Loggen blir igjen. Lisensen kopieres ikke – skriv inn serienummeret på nytt.";
"bootstrap.summary" = "MacReplica %1$@ er i denne sikkerhetskopien (kjører på %2$@).";
"bootstrap.notUniversal" = "Denne kopien kjører bare på Mac-er med %1$@; på en annen Mac laster du ned MacReplica i stedet.";
"bootstrap.readme" = "Start her på den nye Macen: dra %1$@ fra denne mappen til Programmer-mappen og åpne den, velg Gjenopprett og velg denne mappen. MacReplica er ikke notarisert av Apple: hvis macOS sier at utvikleren ikke kan bekreftes, velg Ferdig, åpne Systeminnstillinger › Personvern og sikkerhet og klikk Åpne likevel. Nyeste versjon finner du på %2$@.";
"bootstrap.saved.message" = "Etter at macOS er installert på nytt, åpner du denne sikkerhetskopien og starter MacReplica derfra – uten nedlasting. README-filen i sikkerhetskopien forklarer de første trinnene.";
"bootstrap.missing" = "MacReplica selv er ikke i denne sikkerhetskopien";
