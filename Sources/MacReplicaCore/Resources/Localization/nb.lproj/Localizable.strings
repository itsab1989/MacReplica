"guidance.manual.synologyDrive" = "Synology Drive har ingen eksport av innstillinger, og tilkoblingen er registrert på NAS-en. Installer klienten, opprett synkroniseringsoppgavene på nytt og pek dem til de eksisterende lokale mappene (da synkroniseres bare endringer); koble fra den gamle Macen i Drive Admin Console. MacReplica kopierer ikke klientens database eller økt.";
"guidance.manual.calibrationSoftware" = "Skjermprofiler gjenopprettes med fargeprofilene. Egne forhåndsinnstillinger eller arbeidsflyter ligger i appen: eksporter dem i Preset Manager på den gamle Macen og importer dem på den nye. Lisensen er knyttet til måleinstrumentet.";
"guidance.manual.benqPaletteMaster" = "Maskinvarekalibreringen er lagret i skjermen og blir der. ICC-profilene kommer tilbake med fargeprofilene, lagrede mål med appdataene. Med Palette Master Ultimate kan du også bruke Konto › Backup og Download.";
"guidance.manual.xppenDriver" = "Installer driveren og tillat den i Systeminnstillinger › Personvern og sikkerhet › Tilgjengelighet (XPPenDriver) og Skjermopptak (XPPenTablet), og åpne den på nytt. Den sikreste måten å flytte innstillingene på er driverens egen eksport/import (.pcfg). Sett skjermtilordningen til pennskjermen og kalibrer på nytt.";
"guidance.manual.mailAccounts" = "E-postkontoer og passord kopieres aldri. Legg først til kontoene i Systeminnstillinger › Internettkontoer (eller Mail › Legg til konto); deretter gjenoppretter MacReplica signaturer og regler. Kontroller reglene og de smarte postboksene etterpå. Med iCloud Drive for Mail synkroniseres de av seg selv.";
"guidance.manual.officeActivation" = "Lisenser og pålogginger kopieres aldri. Logg på Microsoft 365 igjen, eller kjør – for volum- eller evigvarende lisens – aktiveringspakken du fikk med lisensen på nytt. Maler, autokorrektur, ordlister og oppstartsfiler gjenoppretter MacReplica separat.";
