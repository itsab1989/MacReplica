  "exclusions": [
    {
      "file": "Downloads/InstallerArchive.swift",
      "pattern": "retryPause \\* UInt64\\(attempt\\)",
      "reason": "Only the pause before a repeated hdiutil verify; >= adds a pause before the first attempt (equivalent mutant)."
    },
    {
      "file": "Restore/RestoreExecutor.swift",
      "pattern": "installed \\+= 1",
      "reason": "Counter for the log line after a stopped administrator copy only (equivalent mutant)."
    },
    {
      "file": "System/CommandRunner.swift",
      "pattern": "guard !data.isEmpty else",
      "reason": "Empty reads are no-ops either way (equivalent mutant)."
    },
    {
      "file": "Restore/RestoreExecutor.swift",
      "pattern": "log\\.(info|warning|error)",
      "reason": "Log-only lines."
    },
    {
      "file": "Restore/RestoreExecutor.swift",
      "pattern": "onEvent\\(\\.activity",
      "reason": "Progress-only events; covered by eventsDescribeEveryStep for the main kinds."
    },
    {
      "file": "Restore/PythonAndDataRestore.swift",
      "pattern": "log\\.(info|warning|error)",
      "reason": "Log-only lines."
    },
    {
      "file": "Restore/PythonAndDataRestore.swift",
      "pattern": "onEvent\\(\\.activity",
      "reason": "Progress-only events."
    },
    {
      "file": "Credentials/Credentials.swift",
      "pattern": "minimumPassphraseLength = 12|defaultIterations = 600_000",
      "reason": "Policy constants; boundaries are tested via the 'short' passphrase and iteration floor."
    },
    {
      "file": "Downloads/DownloadQueue.swift",
      "pattern": "log\\?*\\.(info|warning|error)",
      "reason": "Log-only lines."
    },
    {
      "file": "Downloads/GuidedInstallation.swift",
      "pattern": "log\\?*\\.(info|warning|error)",
      "reason": "Log-only lines."
    },
    {
      "file": "Restore/ToolchainRestore.swift",
      "pattern": "log\\?*\\.(info|warning|error)",
      "reason": "Log-only lines."
    },
    {
      "file": "Downloads/DownloadInstaller.swift",
      "pattern": "log\\?*\\.(info|warning|error)",
      "reason": "Log-only lines."
    },
    {
      "file": "Downloads/DownloadSourceFinder.swift",
      "pattern": "http.statusCode == 200|willPerformHTTPRedirection|task.originalRequest",
      "reason": "URLSessionFetcher talks to real servers; tests use LocalFetcher."
    },
    {
      "file": "Downloads/DownloadQueue.swift",
      "pattern": "task.originalRequest|NSURLErrorCancelled|totalBytesExpectedToWrite|statusCode != 200",
      "reason": "URLSessionDownloadTransport needs a real server; tests use LocalDownloadTransport."
    },
    {
      "file": "Downloads/DownloadQueue.swift",
      "pattern": "if offset == 0 \\|\\|",
      "reason": "Test-only local transport."
    },
    {
      "file": "Downloads/DownloadInstaller.swift",
      "pattern": "withIntermediateDirectories: true",
      "reason": "The parent folder always exists here (equivalent mutant)."
    },
    {
      "file": "Toolchains/ToolchainProvider.swift",
      "pattern": "data.count < 5_000_000",
      "reason": "Size guard against huge metadata files; boundary not meaningful."
    },
    {
      "file": "Downloads/DownloadSourceFinder.swift",
      "pattern": "data.count <= maxBytes",
      "reason": "Size guard; boundary not meaningful."
    },
    {
      "file": "Downloads/GuidedInstallation.swift",
      "pattern": "if await queue.state\\(item.id\\) == nil",
      "reason": "Enqueueing again restarts an equivalent download (equivalent mutant)."
    },
    {
      "file": "Downloads/DownloadSourceFinder.swift",
      "pattern": "recommended: true\\)\\)",
      "reason": "markRecommended sets App Store offers as recommended again (equivalent mutant)."
    },
    {
      "file": "Downloads/DownloadQueue.swift",
      "pattern": "delayPerChunk > 0",
      "reason": "Test-only local transport."
    },
    {
      "file": "Restore/DisplayProfileRestore.swift",
      "pattern": "log\\.(info|warning|error)|onEvent\\(\\.activity",
      "reason": "Log and progress only."
    },
    {
      "file": "ColorProfiles/DisplayProfiles.swift",
      "pattern": "isConnected: Bool = true",
      "operator": "true \u2192 false",
      "reason": "Parameter default only; every caller in the app passes isConnected explicitly (equivalent mutant)."
    },
    {
      "file": "ColorProfiles/DisplayProfiles.swift",
      "pattern": "profiles\\.first\\(where: \\{ \\$0\\.originalPath == path \\}\\)",
      "operator": "first \u2192 last",
      "reason": "A backup holds at most one profile record per original path, so first and last are the same record (equivalent mutant)."
    },
    {
      "file": "Restore/DisplayProfileRestore.swift",
      "pattern": "index\\.entries\\.first \\{ index\\.hash\\(of: \\$0\\) == sha \\}",
      "operator": "first \u2192 last",
      "reason": "Every identical copy of the backed-up profile is a correct profile to assign; which one is used when several exist is not specified."
    },
    {
      "file": "Restore/DisplayProfileRestore.swift",
      "pattern": "manager\\.displays\\(\\)\\.first \\{",
      "operator": "first \u2192 last",
      "reason": "ColorSync device IDs (and their salted keys) are unique, so at most one display matches (equivalent mutant)."
    },
    {
      "file": "Python/PythonPreservation.swift",
      "pattern": "referencesLocalPaths: Bool = false\\) \\{",
      "operator": "false \u2192 true",
      "reason": "Parameter default only; preserve() always passes the value (equivalent mutant)."
    },
    {
      "file": "Python/PythonPreservation.swift",
      "pattern": "architectures\\.sorted \\{ \\$0\\.rawValue < \\$1\\.rawValue \\}",
      "operator": "< \u2192 <=",
      "reason": "Sorts the elements of a set: there are no equal elements (equivalent mutant)."
    },
    {
      "file": "Restore/PythonAndDataRestore.swift",
      "pattern": "createDirectory\\(at: folder, withIntermediateDirectories: true, attributes",
      "operator": "true \u2192 false",
      "reason": "Every credential folder (~/.ssh, ~/.aws, ~/.kube, ~/.terraform.d) is directly in the home folder, which always exists (equivalent mutant)."
    },
    {
      "file": "Restore/PythonAndDataRestore.swift",
      "pattern": "if case \\.existingFileMovedAside = \\$0 \\{ return true \\}; return false",
      "operator": "false \u2192 true",
      "reason": "At this point the notes only ever hold the moved-aside note, so the fallback value is never used (equivalent mutant)."
    },
    {
      "file": "Restore/PythonAndDataRestore.swift",
      "pattern": "profile\\.bundleIdentifiers\\.first\\(where: environment\\.isApplicationRunning\\)",
      "operator": "first \u2192 last",
      "reason": "Any running identifier blocks the restore (tested); which one the detail names when several run at once is not specified."
    },
    {
      "file": "Inventory/AppDataScanner.swift",
      "pattern": "var isDirectory: ObjCBool = false",
